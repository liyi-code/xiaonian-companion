# ============================================================
#  小念（ai-girlfriend）配置模板
#  用法：把本文件复制为 .env，按你自己的环境填写。
#  所有路径都【支持相对路径】，相对的是项目根目录（本文件所在目录），
#  这样整个文件夹拷到别的电脑/别的盘符也能直接跑，不用改绝对路径。
# ============================================================

# ---------- 对话大模型（必填）----------
# 支持 OpenAI 官方，或任意兼容 OpenAI 接口的第三方 / 本地服务（DeepSeek、Ollama、LM Studio…）
# 也可以不填这里，启动后在设置面板(◐)的「API 设置」里随时改、还能“测试连接”。
# 本地版默认走本地 Ollama（需先 `ollama pull qwen2.5:14b` 并启动 Ollama）。
# 想用云端模型：把下面三行改成你的服务商地址 / Key / 模型名即可（DeepSeek、OpenAI、LM Studio…）。
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
MODEL=qwen2.5:14b
# 可在设置面板(◐)里快速切换的模型列表（逗号分隔）
MODELS=qwen2.5:14b,deepseek-chat,deepseek-reasoner

GIRLFRIEND_NAME=小念

# 主动关心间隔（分钟）
PROACTIVE_INTERVAL_MIN=15

# ---------- IM 接入（可选，默认关）----------
QQ_ENABLED=false
QQ_WS_URL=ws://127.0.0.1:6700
QQ_TOKEN=
QQ_OWNER=
WECHAT_ENABLED=false
WECHAT_TYPE=gewe
WECHAT_WS_URL=ws://127.0.0.1:2531
WECHAT_TOKEN=
WECHAT_OWNER=

# ---------- Live2D 形象（可选）----------
LIVE2D_ENABLED=true
# 相对路径（相对项目根）或绝对路径；留空=不显示形象
LIVE2D_MODEL=assets/live2d/hiyori_pro/runtime/hiyori_pro_t11.model3.json
# 嘴型参数名：留空自动探测（从模型 model3.json 的 LipSync 组，回退 ParamMouthOpenY）。
# 若你的模型嘴型参数不叫 ParamMouthOpenY（如老模型用 ParamMouthOpen），在此写死覆盖。
LIVE2D_MOUTH_PARAM=
LIVE2D_PORT=9742
GUI_CONTROL_PORT=9744

# ---------- 语音：麦克风输入(ASR) + 克隆声音输出(TTS)（可选）----------
VOICE_INPUT_ENABLED=true
# local=本地 faster-whisper(离线免费，需先跑 download_model.py 下模型) | openai=OpenAI Whisper API
ASR_BACKEND=local
ASR_MODEL=small
ASR_LANGUAGE=zh
# 麦克风设备：留空=自动优先选名字含「花再」的；也可填设备名子串或索引
ASR_DEVICE=

VOICE_OUTPUT_ENABLED=true
# GPT-SoVITS 推理服务地址（程序会自动拉起，见下方 SOVITS_HOME）
SOVITS_URL=http://127.0.0.1:9880
# GPT-SoVITS 仓库根目录（用于自动拉起 api 服务）。
#   · 放项目同级目录可直接写相对路径，例如把仓库命名为 GPT-SoVITS；
#   · 留空则【不启用语音输出】（其余功能照常），适合没有该依赖的电脑。
SOVITS_HOME=
# 克隆用的参考音频（相对项目根或绝对路径）。需你自己准备一段干净的中文参考音。
SOVITS_REF_AUDIO=ref_yae_clean.wav
SOVITS_REF_TEXT=嗯~伤脑筋，中午吃些什么呢？油豆腐吃腻了，想吃点清淡的。
SOVITS_SPEED=1.0
SOVITS_SAMPLE_STEPS=8
SOVITS_VOLUME=0.4
# 扬声器设备：留空=系统默认；也可填数字索引或设备名子串
TTS_OUTPUT_DEVICE=
# 推理设备：cuda(有 N 卡更快) | cpu；【留空则自动探测】，换电脑不用改
SOVITS_DEVICE=
# GPT-SoVITS 底模（相对 SOVITS_HOME）。不填会回退旧版底模（音质较差）。
SOVITS_GPT=GPT_SoVITS/pretrained_models/gsv-v2final-pretrained/s1bert25hz-5kh-longer-epoch=12-step=369668.ckpt
SOVITS_SOVITS=GPT_SoVITS/pretrained_models/gsv-v2final-pretrained/s2G2333k.pth
SOVITS_IF_SR=false

# ---------- 屏幕陪伴（可选）----------
SCREEN_WATCH_ENABLED=true
SCREEN_WATCH_INTERVAL_SEC=5
SCREEN_WATCH_SETTLE_SEC=20
SCREEN_WATCH_MIN_GAP_MIN=10
SCREEN_WATCH_MILESTONES=30,60,120
SCREEN_CAPTURE_ENABLED=false

# ---------- 多模态视觉（可选，需单独申请视觉模型 Key）----------
VISION_ENABLED=false
VISION_API_KEY=
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4v-flash
VISION_MAX_WIDTH=1280

# ---------- 受约束自主权限（白名单内自调参，绝不动系统/代码）----------
AUTONOMY_ENABLED=true
AUTONOMY_CONFIRM_MAJOR=true
AUTONOMY_ANALYZE_MIN=5
COMFORT_BIAS=0.0
ENCOURAGE_MOTION_ENABLED=false
FILE_BACKUP_ENABLED=false
FILE_BACKUP_INTERVAL_MIN=30

# ---------- 小念替你操作电脑文件（创建/写文本文件，如计划、笔记；默认开）----------
FILE_OPS_ENABLED=true

# ---------- 小念的「性格情感权重系统」（情绪随聊天/行为波动，性格缓慢演变）----------
# 情绪维度：开心/生气/伤心/平静/不安。性格由长期情绪累计的【差值】决定，变化很慢。
# 底层逻辑不变：无论情绪/性格如何，小念的最终目的始终是「让玩家生活越来越好」。
EMOTION_ENABLED=true
# 小念的情绪由【她自己说的话】里流露的关键词决定；玩家的话只是诱导她说什么，不能直接决定她的情绪。
# true=用 LLM 分析小念自己的回复来判断情绪（更准，但每次对话多一次 API 调用）；
# false=用内置关键词规则（零额外开销、离线可用，足够自然）
EMOTION_LLM_PERCEIVE=false
# 长期累计速率（越大性格演变越快）；想让性格更稳定就调小（如 0.5）
EMOTION_ACCUM_RATE=1.0
# 每隔多少分钟分析一次性格演变
EMOTION_ANALYZE_MIN=10

# ---------- 输入条样式 ----------
INPUT_BG=#241f33
INPUT_FG=#ffd9e8
INPUT_ALPHA=0.82
INPUT_TOPMOST=true

# ---------- VRChat OSC 桥（双开方案：你的VR实例 + 她的桌面实例）----------
# 你的实例 OSC 输出口（读你的手势/口型/状态）
OSC_IN_PORT=9011
# 她实例的 OSC 输入口（写她的口型/手势/表情/Chatbox）
OSC_OUT_PORT=9010
OSC_OUT_HOST=127.0.0.1
# 动作教学引擎开关（你比手势+说话教她，她记住"什么时候做什么"）
OSC_LEARN_ENABLED=true
# 同一条教学规则的最小触发间隔(秒)
OSC_RULE_COOLDOWN=180
# TTS 输出设备：填 VB-CABLE 设备名（如 "CABLE Input (VB-Audio Virtual Cable)"），
# 让她的声音走虚拟声卡=她实例的麦克风；留空=系统默认扬声器（只自己听得见）
TTS_OUTPUT_DEVICE=
